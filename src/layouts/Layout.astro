---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "MAAK CORP — contract engineering capacity for agencies",
  description = "Senior full-stack JavaScript and DevOps, delivered on European hours, invoiced from our own company, under your brand.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-bg text-text font-sans">
    <slot />
  </body>
</html>
