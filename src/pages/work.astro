---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Nav from "../components/Nav.astro";
import WorkList from "../components/WorkList.astro";
import PosterBanner from "../components/PosterBanner.astro";
import CalButton from "../components/CalButton.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Work — MAAK CORP"
  description="Products designed and built by MAAK CORP: VAGA, Planifi and GitHub Groups."
>
  <Nav current="work" />

  <Container>
    <section class="pt-28 pb-18">
      <span class="kicker">Work</span>
      <h1
        class="ml-[-0.03em] max-w-[24ch] text-[clamp(34px,4.4vw,56px)] leading-[1.08] tracking-tightest font-extrabold"
      >
        Three products, built end to end and still running.
      </h1>
      <p class="mt-8 max-w-[58ch] text-[19px] leading-8">
        Agency work is delivered white-label and mostly sits behind an NDA — this is what's
        public: products taken from a blank repository to production, and still there.
      </p>
    </section>

    <WorkList />
  </Container>

  <PosterBanner>
    Want something like this built?
    <Fragment slot="action">
      <CalButton class="btn btn-ghost-inverse">Schedule a call</CalButton>
    </Fragment>
  </PosterBanner>

  <Container>
    <Footer />
  </Container>
</Layout>
