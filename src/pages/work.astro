---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Nav from "../components/Nav.astro";
import WorkList from "../components/WorkList.astro";
import WorkDemos from "../components/WorkDemos.astro";
import PosterBanner from "../components/PosterBanner.astro";
import CalButton from "../components/CalButton.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Work — MAAK CORP"
  description="Products designed and built by MAAK CORP: VAGA, Planifi and GitHub Groups, plus self-initiated quote-configurator demos."
>
  <Nav current="work" />

  <Container>
    <section class="pt-28 pb-18">
      <span class="kicker">Work</span>
      <h1
        class="ml-[-0.03em] max-w-[24ch] text-[clamp(34px,4.4vw,56px)] leading-[1.08] tracking-tightest font-extrabold"
      >
        Three products, built end to end and still running.
      </h1>
      <p class="mt-8 max-w-[58ch] text-[19px] leading-8">
        Agency work is delivered white-label and mostly sits behind an NDA — this is what's
        public: products taken from a blank repository to production, and still there.
      </p>
    </section>

    <WorkList />
    <WorkDemos />

    <div class="mb-18 border-2 border-divider px-8 py-10">
      <span class="kicker">Starting from scratch?</span>
      <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-6">
        <h2 class="max-w-[32ch] text-[26px] leading-8 tracking-heading font-extrabold">
          These are our own products — built from a blank repository. If you're starting from
          nothing, the MVP Builder is a fixed-scope way to get there.
        </h2>
        <a href="/mvp-builder" class="btn btn-primary shrink-0">See the MVP Builder</a>
      </div>
    </div>
  </Container>

  <PosterBanner>
    Want something like this built?
    <Fragment slot="action">
      <CalButton class="btn btn-ghost-inverse">Schedule a call</CalButton>
    </Fragment>
  </PosterBanner>

  <Container>
    <Footer />
  </Container>
</Layout>
