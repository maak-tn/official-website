---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Nav from "../components/Nav.astro";
import MvpBenefits from "../components/MvpBenefits.astro";
import MvpProcess from "../components/MvpProcess.astro";
import MvpTools from "../components/MvpTools.astro";
import PosterBanner from "../components/PosterBanner.astro";
import CalButton from "../components/CalButton.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="MVP Builder, MAAK CORP"
  description="A working product, fixed scope and fixed price, built end to end by one senior engineer, from €4,500."
>
  <Nav />

  <Container>
    <section class="pt-28 pb-14">
      <span class="kicker">MVP Builder</span>
      <h1
        class="ml-[-0.058em] max-w-[20ch] text-[clamp(40px,5.6vw,76px)] leading-[1.06] tracking-tightest font-extrabold"
      >
        A working product, not a roadmap.
      </h1>
      <p class="mt-8 max-w-[58ch] text-[19px] leading-8">
        Fixed scope, fixed price, one senior engineer end to end, from a written
        brief to something real users can click through.
      </p>
      <p class="mt-4 max-w-[58ch] text-[15px] leading-6 text-text/70">
        This is the one offer on this site aimed at founders directly,
        everything else here is contract capacity for agencies.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <CalButton>Talk about your MVP</CalButton>
        <a href="/#rates" class="btn btn-ghost">See the pricing</a>
      </div>
    </section>

    <MvpBenefits />
    <MvpProcess />
    <MvpTools />
  </Container>

  <PosterBanner>
    Have a product to get moving?
    <Fragment slot="action">
      <CalButton class="btn btn-ghost-inverse">Talk about your MVP</CalButton>
    </Fragment>
  </PosterBanner>

  <Container>
    <Footer />
  </Container>
</Layout>
