---
const tools = [
  { name: "Google Workspace", body: "Meetings and documentation." },
  { name: "Jira", body: "Internal, dev-oriented backlog." },
  {
    name: "Linear",
    body: "A simpler, client-facing backlog so you can stay up to date without having to ask.",
  },
  {
    name: "GitHub",
    body: "Code repository and CI/CD, migrated to you once the project is done.",
  },
  { name: "Databuddy", body: "Analytics and metrics." },
  { name: "Netlify", body: "Frontend deployment, when it's the right fit." },
  {
    name: "Digital Ocean / Hetzner",
    body: "Staging and production infrastructure.",
  },
  { name: "Namecheap", body: "Domain registration." },
  { name: "Cloudflare", body: "DNS, routing rules, CDN and TLS." },
];
---

<section class="py-18">
  <span class="kicker">Day-to-day tools</span>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-4">
    {
      tools.map((tool) => (
        <div class="card">
          <p class="card-title">{tool.name}</p>
          <p class="card-body">{tool.body}</p>
        </div>
      ))
    }
  </div>
</section>
