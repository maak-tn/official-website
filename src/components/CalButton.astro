---
interface Props {
  class?: string;
}
const { class: className = "btn btn-primary" } = Astro.props;
---

<button
  type="button"
  data-cal-namespace="intro"
  data-cal-link="aymkh/intro"
  data-cal-config={`{"layout":"month_view"}`}
  class={className}
  data-posthog-event="booking_cta_clicked"
>
  <slot />
</button>

<script>
  document
    .querySelectorAll<HTMLButtonElement>(
      '[data-posthog-event="booking_cta_clicked"]',
    )
    .forEach((button) => {
      button.addEventListener("click", () => {
        window.posthog?.capture("booking_cta_clicked", {
          booking_provider: "cal_com",
        });
      });
    });
</script>
