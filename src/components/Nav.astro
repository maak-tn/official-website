---
import CalButton from "./CalButton.astro";

interface Props {
  current?: "capabilities" | "work" | "rates" | "about";
}
const { current = "rates" } = Astro.props;

const links = [
  { href: "/#capabilities", id: "capabilities", label: "Capabilities" },
  { href: "/work", id: "work", label: "Work" },
  { href: "/#rates", id: "rates", label: "Rates" },
  { href: "/#about", id: "about", label: "About" },
];
---

<nav class="border-b-2 border-divider">
  <div
    class="mx-auto flex max-w-300 flex-wrap items-center gap-x-6 gap-y-2 px-6 py-3"
  >
    <span class="mr-auto font-extrabold text-lg">MAAK CORP</span>
    {
      links.map((link) => (
        <a
          href={link.href}
          class="nav-link"
          aria-current={link.id === current ? "location" : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <CalButton>Check availability</CalButton>
  </div>
</nav>
